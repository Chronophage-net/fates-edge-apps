{
  "name": "kon-reh",
  "version": "5.14.2",
  "description": "Fate's Edge Toolkit",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ci": "node --test --test-reporter=spec tests/*.test.mjs",
    "lint": "eslint . --ext .js",
    "lint:ci": "eslint . --ext .js",
    "build": "echo 'Build complete'",
    "ci": "npm run lint:ci && npm run test:ci",
    "version:bump": "node tools/bump-version.mjs",
    "demo": "bash tools/demo.sh",
    "demo:record": "node tools/record-demo.mjs",
    "demo:voice": "bash tools/demo.sh --voice",
    "demo:voice-rvc": "bash tools/demo.sh --voice-rvc",
    "demo:down": "bash tools/demo.sh --down"
  },
  "devDependencies": {
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "_license": "Fate's Edge Copyright – © 2024 - 2026 Nicholas A. Gasper. Used with permission, All rights reserved.",
  "author": "Nicholas A. Gasper"
}
