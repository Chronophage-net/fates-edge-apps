# TURN (coturn) TLS certs -- never commit real certs/keys
utilities/javascript/fates-edge-socket-server/coturn/*.pem

# Web client
# CHANGED: these used to point at a "ttrpg/..." prefix this repo doesn't
# actually have (utilities/javascript/... is the real path -- looks
# copy-pasted from fates-edge-docs' layout, which does use that prefix).
# The blanket node_modules/ and dist/ rules above already cover most of
# this, but keep the specific paths correct and non-misleading.
utilities/javascript/fates-edge-web-client/dist/
utilities/javascript/fates-edge-web-client/.vite/

# Desktop client
utilities/javascript/fates-edge-desktop-client/dist/
utilities/javascript/fates-edge-desktop-client/out/

# Discord bot
utilities/vtt_mods_bots/fates-edge-discord-bot/node_modules/

# Runtime data -- databases are generated/mutable state, not source; they
# don't diff/merge meaningfully and grow forever if tracked. See
# campaigns.db, which was tracked with real session data in its history.
*.db
*.sqlite
*.sqlite3

# Python desktop tool: same class of mistake as campaigns.db above, just
# not caught yet. preferences.json's save_preferences() writes the raw
# server API key entered in the GUI straight to this file in plaintext
# (see Fates_Edge.py's load_preferences() docstring) -- previously
# tracked in git with placeholder content, meaning a routine `git add -A`
# after actually using the tool would have committed a live key. The
# player/gm files are the same idea for campaign data (a live user's
# character sheet/GM notes, not sample content worth diffing in source
# control). Untracked via `git rm --cached`; the files still exist
# on disk and the app recreates them with defaults if missing.
utilities/python/fates_edge_tool/preferences.json
utilities/python/fates_edge_tool/fate_edge_player.json
utilities/python/fates_edge_tool/fate_edge_gm.json

#misc

output.txt
*.tmp

# Local scratch/session noise -- never intended for commit
.claude/
_to_delete/

# docker-compose.voice.yml -- your own reference clip / trained RVC
# model, not sample content worth diffing in source control. The
# folders themselves (and their READMEs) stay tracked via the
# .gitkeep + ! exceptions below.
voice-tts-reference/*
!voice-tts-reference/.gitkeep
!voice-tts-reference/README.md
voice-rvc-models/*
!voice-rvc-models/.gitkeep
!voice-rvc-models/README.md
