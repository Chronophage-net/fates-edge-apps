# Copy to .env.demo (or just let `npm run demo` do it for you).
# Every value below already has a sensible default baked into
# docker-compose.full.yml -- this file only exists so you can tweak
# something without editing the compose file itself. Nothing here is
# required for `npm run demo` / `docker compose -f docker-compose.full.yml
# up --build` to work out of the box.

# ─── Ports ───────────────────────────────────────────────────────
CLIENT_PORT=8080
SERVER_PORT=10000
OLLAMA_PORT=11435
AIGM_STATUS_PORT=4141

# ─── Server / bot shared secret ──────────────────────────────────
# This placeholder is only what ships in the .example template. When
# `npm run demo` (tools/demo.sh) creates your actual .env.demo from
# this file for the first time, it overwrites this with a random
# 32-char key generated on the spot (openssl/node/urandom, whichever
# is available) -- so the server and the AI GM bot still agree on a
# value with zero copy-pasting from logs, but it's unique per machine
# instead of a globally-known string. If you ever hand-create .env.demo
# yourself (skipping tools/demo.sh), replace this placeholder yourself
# before exposing the stack beyond your own machine.
API_KEY=demo-local-key-change-me
CORS_ORIGIN=*
LOG_LEVEL=INFO

# ─── The room the AI GM bot joins ────────────────────────────────
DEMO_ROOM=DEMO
AIGM_BOT_NAME="AI GM"

# ─── Local model (Ollama) ────────────────────────────────────────
# Quickest way to tune this: set DEMO_LEVEL below to a named preset.
# It's an all-or-nothing bundle over the three individual knobs
# further down (DEMO_OLLAMA_MODEL / _CONTEXT_WINDOW / _TIMEOUT_MS) --
# handy if you don't want to think about model names or context
# windows, just "my machine is slow" vs "my machine can handle more."
# It does NOT probe your actual hardware (Docker Desktop's CPU/RAM
# allocation isn't visible to a script outside the container anyway,
# and this is a demo script, not a benchmarking tool) -- just three
# sensible presets, only applied by `npm run demo` (tools/demo.sh);
# running `docker compose` directly does not resolve it.
#   light    -- llama3.2:1b, smaller context, longer timeout. Best if
#               you're not sure your machine can keep up, or you just
#               want the fastest first run.
#   default  -- (or leave unset) whatever DEMO_OLLAMA_MODEL/
#               _CONTEXT_WINDOW/_TIMEOUT_MS below are set to.
#   quality  -- mistral (~4.1GB, slower first pull), for machines with
#               the RAM/CPU to spare and the best GM writing of the lot.
# For anything in between, leave this unset/"default" and tune the
# three vars below yourself.
DEMO_LEVEL=default

# Default is small and fast to pull (~1.3GB) so the whole stack comes
# up quickly on a first run -- good for "does this work at all?" but
# not the sharpest GM writing you'll ever see. Swap in something
# bigger once you know the pipeline works -- a few good options:
#   llama3.2:1b   (~1.3GB, default -- fastest, weakest at following
#                  the [ROLL ...]/[CALL FOR ROLL ...] tag protocol)
#   llama3.2:3b   (~2.0GB, noticeably better instruction-following,
#                  still pulls in a couple of minutes on most connections)
#   mistral       (~4.1GB, the ai-gm-bot repo's own documented default --
#                  best quality of these three, slowest first pull)
# If you change this, also bump DEMO_OLLAMA_CONTEXT_WINDOW to match
# that model's real context window (check `ollama show <model>`).
# Ignored if DEMO_LEVEL above is set to "light" or "quality".
DEMO_OLLAMA_MODEL=llama3.2:1b
DEMO_OLLAMA_CONTEXT_WINDOW=8192

# How long the AI GM bot waits for a single Ollama reply before giving
# up and posting "(AI error)". 60s (the bot's own built-in default) is
# often too tight for Ollama running *inside Docker* -- Docker Desktop
# can't hand a container your GPU (no Metal passthrough on macOS, no
# CUDA without extra host setup on Linux/WSL), so generation runs on
# CPU only and can comfortably take longer than that, especially on
# the first request after the model loads or while other containers
# are competing for the same CPU allocation. Bump this before assuming
# something's broken if you're seeing "(AI error)" and the logs show
# Ollama requests timing out around 60000ms. 180000 (3 min) is a safe
# starting point for CPU-only inference; lower it once you've confirmed
# your machine replies faster than that.
# Ignored if DEMO_LEVEL above is set to "light" or "quality".
DEMO_OLLAMA_TIMEOUT_MS=180000
