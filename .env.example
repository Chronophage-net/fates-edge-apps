# Copy to .env. Every value below is optional -- `docker-compose up`
# with an untouched .env (or no .env at all) still brings up a fully
# working web client + server. Fill in a section only if you're
# enabling the matching profile (see docker-compose.yml's header
# comment for the full list of `--profile` flags).

# ─── Ports ───────────────────────────────────────────────────────
CLIENT_PORT=8080
SERVER_PORT=10000

# Optional PUBLIC browser-facing addresses when using an HTTPS reverse proxy.
# Leave both blank for LAN HTTP: the client uses the NAS hostname/IP and SERVER_PORT.
# Changes need `docker compose up -d --build client`, not merely a restart.
# Example: PUBLIC_WS_URL=wss://game.example.com
#          PUBLIC_SERVER_URL=https://game.example.com
# Do not use Docker's internal hostname "server" or put API keys in these URLs.
PUBLIC_WS_URL=
PUBLIC_SERVER_URL=

# ─── Server ──────────────────────────────────────────────────────
# Leave blank and the server auto-generates + logs one at startup
# (`docker-compose logs server`). Set it explicitly so bots below can
# be pre-configured with it and it survives container restarts.
API_KEY=
CORS_ORIGIN=*
LOG_LEVEL=INFO

# ─── `--profile turn`: coturn TURN relay for voice chat ─────────
# Fixes voice chat for players behind symmetric NAT / strict
# firewalls. Without this, voice chat still works for most players
# via STUN, just not all of them.
TURN_SECRET=
TURN_REALM=fates-edge
TURN_URLS=turn:your-domain-or-ip:3478
TURN_PUBLIC_IP=
TURN_ENABLE_TLS=false
TURN_CREDENTIAL_TTL=86400

# ─── `--profile ai-gm-bot` (or `bots`) ───────────────────────────
# Requires cloning fates-edge-ai-gm-bot as a sibling directory --
# see docker-compose.yml's header comment.
AIGM_ROOM=AC12
AIGM_BOT_NAME=AIGM
AI_PROVIDER=openai
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=

# ─── `--profile discord-bot` (or `bots`) ─────────────────────────
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_ROOM_CODE=AC12
DISCORD_PREFIX=!
