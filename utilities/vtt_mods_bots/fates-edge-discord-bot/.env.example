# Discord Bot Configuration
DISCORD_TOKEN=YOUR_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_CLIENT_ID
DISCORD_GUILD_ID=YOUR_GUILD_ID (optional, for dev)

# Fate's Edge VTT Server
VTT_SERVER_URL=ws://localhost:10000
VTT_API_KEY=your-api-key
VTT_ROOM_CODE=AC12

# Bot Settings
PREFIX=!
ACTIVITY_TYPE=PLAYING
ACTIVITY_NAME=Fate's Edge VTT
LOG_LEVEL=info

# Web Interface (optional)
WEBHOOK_PORT=3001
WEBHOOK_SECRET=your-webhook-secret

# AI GM Voice Narration (optional -- see utils/tts-voice.js; requires the
# AI GM Bot's own TTS_ENABLED/TTS_URL to be set too, and DISCORD_GUILD_ID
# above. Also needs an Opus encoder + FFmpeg installed -- see package.json's
# "_note_voice".)
DISCORD_TTS_ENABLED=false
DISCORD_TTS_VOICE_CHANNEL_ID=
