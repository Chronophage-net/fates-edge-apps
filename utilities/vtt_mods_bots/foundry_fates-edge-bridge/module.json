{
  "id": "fates-edge-bridge",
  "title": "Fate's Edge Bridge",
  "description": "Connects Foundry VTT to the Fate's Edge WebSocket server for real-time sync of chat, dice rolls, characters, timers, ad-hoc timers, scenes, Deck of Consequences, Crown Spread, modules, and Game Master election/promotion.",
  "version": "4.17.0",
  "authors": [
    {
      "name": "Nicholas A. Gasper"
    }
  ],
  "esmodules": [
    "scripts/main.js"
  ],
  "styles": [
    "styles/style.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "compatibility": {
    "minimum": "11",
    "maximum": "13"
  },
  "socket": true,
  "url": "https://github.com/Chronophage-net/fates-edge-apps",
  "readme": "https://github.com/Chronophage-net/fates-edge-apps/tree/main/utilities/vtt_mods_bots/foundry_fates-edge-bridge",
  "changelog": "https://github.com/Chronophage-net/fates-edge-apps/blob/main/CHANGELOG.md",
  "bugs": "https://github.com/Chronophage-net/fates-edge-apps/issues",
  "allowBugReporter": true,
  "packs": [],
  "relationships": {
    "requires": [],
    "systems": [],
    "modules": []
  },
  "flags": {
    "hotReload": {
      "extensions": [
        "js",
        "css",
        "html",
        "json"
      ]
    },
    "fates-edge": {
      "version": "2.2.0",
      "features": [
        "chat-sync",
        "dice-sync",
        "character-sync",
        "timer-sync",
        "adhoc-timer-sync",
        "scene-sync",
        "deck-sync",
        "crown-spread",
        "module-management",
        "region-support",
        "gm-management",
        "gm-election",
        "gm-promotion"
      ],
      "protocolVersion": 2
    }
  },
  "_license": "Fate's Edge Copyright \u2013 \u00a9 2024 - 2026 Nicholas A. Gasper. Used with permission, All rights reserved."
}
