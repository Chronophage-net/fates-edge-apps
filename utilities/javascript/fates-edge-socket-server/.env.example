# Fate's Edge socket server settings.
#
# `npm run setup` at the repository root writes a working .env from this
# file, with generated secrets. To do it by hand: copy this file to .env
# and set API_KEY and AUTH_JWT_SECRET. Docker Compose reads the same
# file. Every setting is optional except where noted; the values shown
# are the defaults.

# ─── Essentials ─────────────────────────────────────────────────
PORT=10000
# Admin key for the REST API, the CLI, the /console page and the AI GM
# bot (the bot's API_KEY must match). Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Left blank, the server makes a temporary key at each start.
API_KEY=
# Signs player sign-in tokens. Left blank, sign-ins end at each restart.
AUTH_JWT_SECRET=
# Websites allowed to call the REST API from a browser: * for any, or a
# comma-separated list such as https://play.example.com
CORS_ORIGIN=*
# Interface to listen on: 0.0.0.0 for every interface, 127.0.0.1 for this machine only.
HOST=0.0.0.0

# ─── Logging ────────────────────────────────────────────────────
LOG_LEVEL=INFO
# text (default) or json for log collectors
LOG_FORMAT=
# How often (ms) the server logs a stats line while anyone is connected
STATS_INTERVAL=30000

# ─── Storage ────────────────────────────────────────────────────
# sqlite (default, a file next to the server), postgres or mysql.
DATABASE_TYPE=sqlite
# Required for postgres/mysql, e.g. postgres://user:pass@host:5432/fates_edge
DATABASE_URL=
DATABASE_SSL=false

# ─── Rooms and limits ───────────────────────────────────────────
MAX_CLIENTS_PER_ROOM=0
MAX_DECK_HISTORY=100
# Chat lines sent to someone who joins mid-session (0 disables)
MAX_CHAT_HISTORY=50
API_RATE_LIMIT_MAX=300
API_RATE_LIMIT_WINDOW_MS=60000
WS_MESSAGE_RATE_MAX=120
WS_MESSAGE_RATE_WINDOW_MS=10000
# Behind a reverse proxy: false, a hop count (1), or trusted proxy addresses
TRUST_PROXY=false

# ─── Optional features ──────────────────────────────────────────
# Soundboard "Search Sounds": a free key from https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# Voice chat relay (TURN) for players behind strict firewalls. Without
# it voice still works peer-to-peer for most home networks. Set
# TURN_SECRET and the public address players can reach.
TURN_SECRET=
TURN_REALM=fates-edge
TURN_URLS=
TURN_CREDENTIAL_TTL=86400
# Docker's coturn container only: public IP when the host's own IP is private,
# and TLS once ./coturn/cert.pem and ./coturn/key.pem are in place.
TURN_PUBLIC_IP=
TURN_ENABLE_TLS=false

# ─── Scaling (larger deployments) ───────────────────────────────
# Share rooms between several server processes through Redis
REDIS_URL=
# Use every CPU core on this machine: a number, or auto
CLUSTER_WORKERS=0

# ─── Managed node (only with the SaaS manager) ──────────────────
# Setting MANAGER_URL makes this whole process a managed node: every join
# needs a manager token. The manager's `npm run setup` writes these.
MANAGER_URL=
MANAGER_SERVER_ID=
MANAGER_NODE_CREDENTIAL=
MANAGER_PUBLIC_URL=
MANAGER_NODE_NAME=
MANAGER_CAPACITY_ROOMS=100
MANAGER_REGION=default
