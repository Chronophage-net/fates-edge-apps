# Copy to .env and fill in before running `docker-compose up`.
# See env-example.md for the full list of server-only settings (these
# are just the ones docker-compose.yml itself references).

# ─── Server ──────────────────────────────────────────────────────
PORT=10000
API_KEY=change-me-to-a-real-secret
CORS_ORIGIN=*
LOG_LEVEL=INFO

# Optional: enables the soundboard's "Search Sounds" feature (proxies
# Freesound). Get a free key at https://freesound.org/apiv2/apply/.
# Feature is silently disabled (503) if left blank.
FREESOUND_API_KEY=

# ─── TURN (voice chat NAT traversal) ────────────────────────────
# Leave TURN_SECRET blank to run without TURN (voice chat still works
# via STUN for most home networks; symmetric NAT / strict firewalls
# won't be able to connect).
TURN_SECRET=
TURN_REALM=fates-edge
# Public hostname or IP players' browsers can reach the coturn
# container on. Required once TURN_SECRET is set.
TURN_URLS=turn:your-domain-or-ip:3478
TURN_CREDENTIAL_TTL=86400

# Only needed if coturn is running on a host with a private IP that
# differs from its public-facing IP (common on cloud VMs) -- tells
# coturn which IP to hand out in relay candidates.
TURN_PUBLIC_IP=

# Set to "true" once you've mounted a real TLS cert/key at
# ./coturn/cert.pem and ./coturn/key.pem, then add the matching
# turns:// entry to TURN_URLS above.
TURN_ENABLE_TLS=false
