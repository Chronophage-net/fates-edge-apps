  "_license": "Code: MIT. Game content (including /data/docs, /data/patrons, /data/adventures, etc.): CC BY-NC-SA 4.0 (SRD-marked) / All Rights Reserved (proprietary). © 2024 Nicholas A. Gasper.",
  "author": "Nicholas A. Gasper",
  "allowScripts": {
    "fsevents@2.3.3": true,
    "esbuild@0.28.1": true
  }
}
