{
  "name": "fates-edge-web-client",
  "version": "4.4.1",
  "type": "module",
  "description": "Fate's Edge Toolkit Web Client",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:manifests && vite build",
    "preview": "vite preview",
    "serve": "npx serve -s dist -l ${PORT:-10000}",
    "start": "npm run dev",
    "test": "node tests/runner.js",
    "seed": "node js/tools/generate-seed.js",
    "build:manifests": "node js/tools/generate-manifests.js",
    "precommit": "npm run build",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "esbuild": "^0.28.1",
    "serve": "^6.5.8"
  },
  "devDependencies": {
    "vite": "^8.2.0"
  },
