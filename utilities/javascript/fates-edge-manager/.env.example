MANAGER_ORIGIN=http://localhost:3100
HOST=127.0.0.1
PORT=3100
MANAGER_DATABASE_URL=postgresql://manager:replace-this@127.0.0.1:15432/fates_edge_manager
MANAGER_PEPPER=replace-with-at-least-32-random-characters
MANAGER_SIGNING_KEY_FILE=secrets/signing.pem
# Stable socket-node UUID -> distinct randomly generated service credential.
MANAGER_NODE_CREDENTIALS={}
# Provider secret values are read from the named environment variable.
MANAGER_OIDC_PROVIDERS=[]
# Example: [{"name":"school","display_name":"School SSO","issuer":"https://sso.example.com/realms/fates","client_id":"fates-manager","client_secret_env":"SCHOOL_OIDC_SECRET"}]
MANAGER_BOOTSTRAP_USERNAME=operator
MANAGER_BOOTSTRAP_PASSWORD=replace-with-at-least-12-characters
MANAGER_DB_PASSWORD=replace-this
