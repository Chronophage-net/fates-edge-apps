{
  "name": "fates-edge-client",
  "version": "5.15.0",
  "description": "Fate's Edge VTT Desktop Client",
  "main": "electron.js",
  "author": "Nicholas A. Gasper",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Chronophage-net/fates-edge-apps.git"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "copy-renderer": "node scripts/copy-renderer.js",
    "prestart": "npm run copy-renderer",
    "start": "electron .",
    "predev": "npm run copy-renderer",
    "dev": "electron . --dev",
    "prebuild": "npm run copy-renderer",
    "build": "node scripts/build.js",
    "prebuild:mac": "npm run copy-renderer",
    "build:mac": "electron-builder --mac --universal",
    "prebuild:win": "npm run copy-renderer",
    "build:win": "electron-builder --win",
    "prebuild:linux": "npm run copy-renderer",
    "build:linux": "electron-builder --linux",
    "build:all": "npm run build && npm run build:mac && npm run build:win && npm run build:linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "electron-log": "^5.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9"
  },
  "overrides": {
    "plist@3.1.1": {
      "@xmldom/xmldom": "^0.9.12"
    },
    "global-agent": "^4.1.3"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "devDependencies": {
    "ci-info": "^3.7.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-builder-squirrel-windows": "^26.15.3",
    "eslint": "^8.55.0",
    "rimraf": "^5.0.5"
  },
  "build": {
    "appId": "com.fatesedge.client",
    "productName": "FatesEdge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron.js",
      "preload.js",
      "security.js",
      "package.json",
      "fe_icon.png",
      "renderer/**/*",
      "!node_modules/.bin",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "publisherName": "Fate's Edge"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.games",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "build/icon.png",
      "category": "Game",
      "maintainer": "Fate's Edge <support@fates-edge.com>"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Chronophage-net",
      "repo": "fates-edge-apps",
      "releaseType": "release"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "_license": "Fate's Edge Copyright – © 2024 - 2026 Nicholas A. Gasper. Used with permission, All rights reserved."
}
